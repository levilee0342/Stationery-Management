<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_coupon_container"
    android:padding="4dp"
    android:layout_margin="8dp">

    <!-- Cột trái: Icon và loại mã -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_coupon_left"
        android:padding="8dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_discount_percent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Discount"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cột phải: Thông tin mã -->
    <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="3"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <!-- Tiêu đề mã -->
        <TextView
            android:id="@+id/coupon_name"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableRight="@drawable/ic_information"
            android:text="MÃ GIẢM 25K - POP MART"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <!-- Nội dung mô tả -->
        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Áp dụng cho Đơn Mua Mô Hình Pop Mart\nWealthy Snake's New Year Celebration"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/coupon_expiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EXP: 31/05/2025"
                android:textColor="#888888"
                android:textSize="12sp" />

            <Button
                android:id="@+id/apply_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/primary_blue"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
