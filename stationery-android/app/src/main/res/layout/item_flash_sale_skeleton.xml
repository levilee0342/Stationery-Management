<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Skeleton cho sản phẩm 1 -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Placeholder cho hình ảnh sản phẩm -->
            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="12dp"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho tên sản phẩm -->
            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho giá sản phẩm -->
            <View
                android:layout_width="120dp"
                android:layout_height="18dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho giá gốc (gạch ngang) -->
            <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho rating -->
            <View
                android:layout_width="60dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho số lượng đã bán -->
            <View
                android:layout_width="100dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_gradient"
                android:animation="@anim/shimmer_gradient_animation"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Skeleton cho sản phẩm 2 -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Placeholder cho hình ảnh sản phẩm -->
            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="12dp"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho tên sản phẩm -->
            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho giá sản phẩm -->
            <View
                android:layout_width="120dp"
                android:layout_height="18dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho giá gốc (gạch ngang) -->
            <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho rating -->
            <View
                android:layout_width="60dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_gradient"
                android:layout_marginBottom="8dp"
                android:animation="@anim/shimmer_gradient_animation"/>

            <!-- Placeholder cho số lượng đã bán -->
            <View
                android:layout_width="100dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_gradient"
                android:animation="@anim/shimmer_gradient_animation"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>