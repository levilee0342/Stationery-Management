<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".firebase.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo_new"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_logo_new_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Office_Management"
        android:usesCleartextTraffic="true"
        android:windowSoftInputMode="adjustResize"
        tools:targetApi="34">
        <activity
            android:name=".activity.auth.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activity.shopping.ShoppingGuide"
            android:exported="false"
            android:theme="@style/Theme.Office_Management" />
        <activity
            android:name=".activity.order.OrderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".activity.product.ProductActivity"
            android:exported="false"
            android:theme="@style/Theme.Office_Management" />
        <activity
            android:name=".activity.user.NotificationActivity"
            android:exported="true" />
        <activity
            android:name=".activity.order.OrderHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".activity.user.UserInforActivity"
            android:exported="false" />
        <activity
            android:name=".activity.user.VoucherActivity"
            android:exported="false" />
        <activity
            android:name=".activity.review.ReviewListActivity"
            android:exported="false" />
        <activity
            android:name=".activity.review.WriteReviewActivity"
            android:exported="false" />
        <activity
            android:name=".activity.address.AddressActivity"
            android:exported="false" />
        <activity
            android:name=".activity.user.CouponCodeActivity"
            android:exported="false" />
        <activity
            android:name=".activity.checkout.CheckOrderActivity"
            android:exported="false" />
        <activity
            android:name=".activity.checkout.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".activity.address.ShippingActivity"
            android:exported="false" />
        <activity
            android:name=".activity.search.ProductSearchActivity"
            android:exported="false" />
        <activity
            android:name=".activity.product.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".activity.search.SearchActivity"
            android:exported="false" /> <!-- Đặt SplashScreenActivity làm activity mặc định -->
        <activity
            android:name=".activity.layout.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.Office_Management" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.auth.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activity.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.MainActivity" />
        </activity>

        <service
            android:name=".firebase.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>